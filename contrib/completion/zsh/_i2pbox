#compdef i2pbox
# zsh completion for i2pbox — install to $fpath, e.g. /usr/share/zsh/site-functions/
_i2pbox() {
  local -a cmds
  cmds=(
    'vain:Generate vanity .b32.i2p address'
    'keygen:Generate random I2P keys'
    'keyinfo:Display info about a private key'
    'famtool:Router family: generate, sign, or verify'
    'routerinfo:Display router info'
    'regaddr:Register an I2P address'
    'regaddr_3ld:Register a 3LD address'
    'i2pbase64:Encode/decode I2P Base64'
    'offlinekeys:Generate offline signing keys'
    'b33address:Convert Base64 destination to b33'
    'regaddralias:Register an address alias'
    'x25519:Generate X25519 key pair'
    'verifyhost:Verify host record signature'
    'autoconf_i2pd:Interactive i2pd.conf generator'
    'help:Show help'
    'version:Show version'
  )
  if (( CURRENT == 2 )); then
    _describe 'command' cmds
    return
  fi
  case "$words[2]" in
    keyinfo) _arguments '-h[help]' '--help[help]' '-v[verbose]' '-d[destination]' '-p[private]' '-b[blinded]' ;;
    routerinfo) _arguments '-6[ipv6]' '-f[firewall]' '-p[port]' '-y[yggdrasil]' '-h[help]' '--help[help]' ;;
    i2pbase64) _arguments '-d[decode]' '-h[help]' '--help[help]' ;;
    famtool) _arguments '-h[help]' '-v[verbose]' '-g[generate]' '-s[sign]' '-V[verify]' '-n[family]:' '-c[cert]:' '-k[key]:' '-i[keys]:' '-f[info]:' '-P[password]:' '-e[days]:' ;;
    vain) _arguments '-h[help]' '--help[help]' '-r[regex]' '-t[threads]:' '-o[output]:' '-m[multi]' ;;
    *) _arguments '-h[help]' '--help[help]' ;;
  esac
}
compdef _i2pbox i2pbox
