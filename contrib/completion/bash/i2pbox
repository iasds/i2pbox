# bash completion for i2pbox — source this file or install to /etc/bash_completion.d/
_i2pbox_complete() {
  local cur prev cmds
  cmds="vain keygen keyinfo famtool routerinfo regaddr regaddr_3ld i2pbase64 offlinekeys b33address regaddralias x25519 verifyhost autoconf_i2pd help version"
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  # subcommand as first arg
  if [ $COMP_CWORD -eq 1 ]; then
    COMPREPLY=( $(compgen -W "$cmds" -- "$cur") )
    return
  fi
  case "${COMP_WORDS[1]}" in
    keyinfo) COMPREPLY=( $(compgen -W "-h --help -v -d -p -b" -- "$cur") ) ;;
    keygen)  COMPREPLY=( $(compgen -W "--help -h" -- "$cur") ) ;;
    routerinfo) COMPREPLY=( $(compgen -W "-6 -f -p -y -h --help" -- "$cur") ) ;;
    i2pbase64)  COMPREPLY=( $(compgen -W "-d -h --help" -- "$cur") ) ;;
    famtool)    COMPREPLY=( $(compgen -W "-h -v -g -s -V -n -c -k -i -f -o -P -e" -- "$cur") ) ;;
    vain)       COMPREPLY=( $(compgen -W "-h --help -r -t -o -m" -- "$cur") ) ;;
    b33address) COMPREPLY=( $(compgen -W "-h --help" -- "$cur") ) ;;
    *) COMPREPLY=( $(compgen -W "-h --help" -- "$cur") ) ;;
  esac
}
complete -F _i2pbox_complete i2pbox
